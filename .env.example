JWT_SECRET=change-me-in-production-use-random-64-chars
ADMIN_EMAIL=admin@photogal.com
ADMIN_PASSWORD=changeme123
NODE_ENV=development

# Google Sign-In (optionnel — laisser vide pour désactiver)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# MinIO / S3 (dev : `npm run dev:infra`). Le bucket doit finir par "-dev" pour que `npm run seed` accepte de tourner.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=photogal-dev
STORAGE_LIMIT_GB=10

# SQLite (relatif à apps/api en dev ; Docker : /app/data/photogal.db)
DB_PATH=./data/dev.db

# Optionnel : email ajouté aux accès de l'album "Famille Martin" (tester « Mes albums » via Google)
# SEED_USER_EMAIL=

# Mettre à true si l'API est derrière un reverse proxy (nginx, Traefik…), pour que la limite
# d'essais de mot de passe d'album s'applique par client et non à l'IP du proxy.
# TRUST_PROXY=true

# Charge (Raspberry Pi) : nombre d'images traitées en même temps (conversion HEIC, miniatures),
# mémoire maximale du conteneur api et taille du tas Node. À augmenter sur une machine plus puissante.
# IMAGE_CONCURRENCY=1
# API_MEM_LIMIT=1g
# API_HEAP_MB=384

# Sauvegarde nocturne chiffrée vers Google Drive (service `backup`, voir deploy/backup/README.md).
# Les deux secrets crypt sont des valeurs passées par `rclone obscure` : garder les mots de passe
# EN CLAIR dans un gestionnaire de mots de passe, sans eux les sauvegardes sont illisibles.
# BACKUP_GDRIVE_TOKEN={"access_token":"…","token_type":"Bearer","refresh_token":"…","expiry":"…"}
# BACKUP_CRYPT_PASSWORD=
# BACKUP_CRYPT_SALT=
# BACKUP_SCHEDULE=0 3 * * *
