JWT_SECRET=change-me-in-production-use-random-64-chars
ADMIN_EMAIL=admin@photogal.com
ADMIN_PASSWORD=changeme123
NODE_ENV=development

# Google Sign-In (optionnel — laisser vide pour désactiver)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# MinIO / S3 (dev : `npm run dev:infra`). Le bucket doit finir par "-dev" pour que `npm run seed` accepte de tourner.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=photogal-dev
STORAGE_LIMIT_GB=10

# SQLite (relatif à apps/api en dev ; Docker : /app/data/photogal.db)
DB_PATH=./data/dev.db

# Optionnel : email ajouté aux accès de l'album "Famille Martin" (tester « Mes albums » via Google)
# SEED_USER_EMAIL=

# Mettre à true si l'API est derrière un reverse proxy (nginx, Traefik…), pour que la limite
# d'essais de mot de passe d'album s'applique par client et non à l'IP du proxy.
# TRUST_PROXY=true
