{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run test --workspace @photogal/api)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run dev:infra)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ],
    "ask": ["Bash(npm run seed:*)", "Bash(npm run dev:fresh:*)", "Bash(git push:*)"],
    "deny": ["Edit(./.env)", "Write(./.env)", "Bash(docker compose * down -v:*)", "Bash(docker volume rm:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"", "timeout": 180 }
        ]
      }
    ]
  }
}
