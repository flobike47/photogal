{
  "name": "photogal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @photogal/api",
    "dev:web": "npm run dev --workspace @photogal/web",
    "build": "npm run build --workspace @photogal/api && npm run build --workspace @photogal/web",
    "typecheck": "npm run typecheck --workspace @photogal/api && npm run typecheck --workspace @photogal/web",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "seed": "npm run seed --workspace @photogal/api",
    "dev:fresh": "npm run seed && npm run dev",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @photogal/api",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
